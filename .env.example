# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# --- Google Cloud / Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Application Settings ---
# APP_URL=http://0.0.0.0:8000
# AGENT_VERSION=0.1.0

# --- CORS (comma-separated origins, leave empty to restrict all) ---
# ALLOW_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# --- Session & Artifact Storage ---
# SESSION_SERVICE_URI=shared://session
# For persistent sessions via Agent Runtime, set GOOGLE_CLOUD_AGENT_ENGINE_ID instead.
# For GCS artifact storage:
# LOGS_BUCKET_NAME=your-gcs-bucket-name

# --- Observability ---
# Enable prompt/response logging (requires LOGS_BUCKET_NAME):
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT

# --- Production Security ---
# IMPORTANT: For production deployments, use GCP Secret Manager instead of
# plain-text environment variables. Pass secrets at deploy time:
#   agents-cli deploy --secrets "API_KEY=my-api-key,DB_PASS=db-password"
# See: https://cloud.google.com/secret-manager/docs
